  "disa_manual_rule_sha256": "81a2d1e2a608f1fbc8db51114b3cd9f8f93c9ce38f52a1ebe0d850c6a8178ee7",
  "disa_check": "Verify \"/var/log/audit\" is mounted with the \"nodev\" option:\n\n$ mount | grep /var/log/audit\n\n/dev/mapper/rhel-var-log-audit on /var/log/audit type xfs (rw,nodev,nosuid,noexec,seclabel)\n\nIf the \"/var/log/audit\" file system is mounted without the \"nodev\" option, this is a finding.",
  "niwc_check": "Verify \"/var/log/audit\" is mounted with the \"nodev\" option:\n\n$ mount | grep /var/log/audit\n\n/dev/mapper/rhel-var-log-audit on /var/log/audit type xfs (rw,nodev,nosuid,noexec,seclabel)\n\nIf the \"/var/log/audit\" file system is mounted without the \"nodev\" option, this is a finding.",
  "normalized_checks_identical": true,
