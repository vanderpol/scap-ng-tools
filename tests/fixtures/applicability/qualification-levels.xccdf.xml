<?xml version="1.0" encoding="UTF-8"?>
<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.2"
           xmlns:cpe="http://cpe.mitre.org/language/2.0"
           id="xccdf_example_benchmark_applicability_qualification" resolved="1">
  <status>accepted</status>
  <title>Applicability hierarchy qualification fixture</title>
  <description>Standalone standards-conformant XCCDF 1.2 hierarchy fixture.</description>
  <cpe:platform-specification>
    <cpe:platform id="fixture-benchmark-platform">
      <cpe:title>Fixture benchmark platform</cpe:title>
      <cpe:logical-test operator="AND" negate="false">
        <cpe:logical-test operator="OR" negate="false">
          <cpe:check-fact-ref system="http://oval.mitre.org/XMLSchema/oval-definitions-5"
                              href="fixture-oval.xml" id-ref="oval:fixture:known"/>
          <cpe:check-fact-ref system="http://oval.mitre.org/XMLSchema/oval-definitions-5"
                              href="fixture-oval.xml" id-ref="oval:fixture:unknown"/>
        </cpe:logical-test>
      </cpe:logical-test>
    </cpe:platform>
  </cpe:platform-specification>
  <platform idref="#fixture-benchmark-platform"/>
  <version>1.0</version>
  <model system="urn:xccdf:scoring:default"/>
  <Profile id="xccdf_example_profile_fixture_disabled">
    <title>Disable the FALSE fixture rule</title>
    <select idref="xccdf_example_rule_false" selected="false"/>
  </Profile>
  <Group id="xccdf_example_group_outer">
    <title>Outer platform group</title>
    <platform idref="cpe:/a:fixture:outer"/>
    <Group id="xccdf_example_group_inner">
      <title>Nested platform group</title>
      <platform idref="cpe:/a:fixture:inner"/>
      <Rule id="xccdf_example_rule_true" selected="true">
        <title>TRUE applicability case</title>
        <description>Independent TRUE case is supplied by the RI probe.</description>
        <platform idref="cpe:/a:fixture:true"/>
      </Rule>
      <Rule id="xccdf_example_rule_false" selected="true">
        <title>FALSE applicability case</title>
        <description>Independent FALSE case is supplied by the RI probe.</description>
        <platform idref="cpe:/a:fixture:false"/>
      </Rule>
      <Rule id="xccdf_example_rule_unknown" selected="true">
        <title>UNKNOWN applicability case</title>
        <description>Independent UNKNOWN case is supplied by the RI probe.</description>
        <platform idref="cpe:/a:fixture:unknown"/>
      </Rule>
      <Rule id="xccdf_example_rule_error" selected="true">
        <title>ERROR applicability case</title>
        <description>Unqualified CPE mappings remain an explicit ERROR hold.</description>
        <platform idref="cpe:/a:fixture:error"/>
      </Rule>
    </Group>
  </Group>
</Benchmark>
